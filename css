body {
    font-family: Arial;
    background-color: #eeeeee;
    margin: 0;
}

header {
    background-color: #0066cc;
    color: white;
    text-align: center;
    padding: 30px;
}

h1 {
    font-size: 40px;
}

h2 {
    text-align: center;
    font-size: 30px;
}

.cleats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 20px;
}

.cleat {
    background-color: white;
    width: 220px;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 3px 8px gray;
}

.cleat img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
}

.cleat h3 {
    font-size: 18px;
}

.cleat p {
    color: #555;
}

.cleat b {
    color: #0066cc;
    font-size: 22px;
}

footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}
